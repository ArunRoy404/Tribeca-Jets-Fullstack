# ---- Dependencies ----------------------------------------------------------
node_modules
.npm
.pnp
.pnp.js

# ---- Build output ----------------------------------------------------------
/dist
/build
*.tsbuildinfo

# ---- Secrets ---------------------------------------------------------------
# Never commit real env files. .env.example is the committed template.
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
*.pem
*.key

# ---- Generated code --------------------------------------------------------
# Prisma Client is generated from prisma/schema/. Regenerate with:
#   npm run db:generate
src/generated

# ---- Runtime data ----------------------------------------------------------
# Root of the local storage driver — uploaded documents, passports, IDs.
# Never belongs in git; back it up separately from the database.
#
# The leading slash is load-bearing. Without it the pattern matches at every
# depth, and `storage` silently excluded src/core/storage/ — the whole storage
# module — from git. It built locally and failed on the first real deploy.
/storage
/uploads

# ---- Logs ------------------------------------------------------------------
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed

# ---- Test / tooling caches -------------------------------------------------
/coverage
.nyc_output
.vitest
vite.config.ts.timestamp-*
vitest.config.ts.timestamp-*
.eslintcache
.oxlintcache

# ---- Editors / OS ----------------------------------------------------------
.DS_Store
Thumbs.db
.idea
*.swp
*.swo
.vscode/*
!.vscode/extensions.json

# Python bytecode from the Postman collection builders in postman/.
__pycache__/
*.py[cod]
