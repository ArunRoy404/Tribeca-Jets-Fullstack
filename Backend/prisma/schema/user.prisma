/// Staff accounts. Clients authenticate through the separate client portal and
/// are NOT users — see client.prisma.
model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?

  role UserRole @default(BROKER)

  /// Lead-desk settings, shown on the Agents roster.
  ///
  /// `maxActiveLeads` is what the workload indicator is measured against —
  /// without it "Medium" is an opinion rather than a ratio. Null means no cap
  /// has been set, and the roster says so instead of assuming one.
  maxActiveLeads        Int?
  /// Prefills the follow-up dialog for leads this broker owns.
  defaultFollowUpMethod FollowUpMethod?
  status                UserStatus      @default(ACTIVE)

  /// Storage key (not a URL) — resolved by StorageService at read time so the
  /// same record works on both the S3 and local drivers.
  avatarKey String?

  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  lastLoginAt DateTime?

  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  verificationCodes VerificationCode[]

  /// Clients where this user owns the relationship.
  assignedClients   Client[] @relation("ClientAssignedBroker")
  /// Clients this user originally brought in; drives commission attribution
  /// and is deliberately independent of the current assignee.
  originatedClients Client[] @relation("ClientOriginatingBroker")
  createdClients    Client[] @relation("ClientCreatedBy")
  updatedClients    Client[] @relation("ClientUpdatedBy")

  /// Reference data this user entered or last touched. Audit back-references
  /// only — airports and operators are shared and belong to nobody.
  createdAirports       Airport[]       @relation("AirportCreatedBy")
  updatedAirports       Airport[]       @relation("AirportUpdatedBy")
  createdOperators      Operator[]      @relation("OperatorCreatedBy")
  updatedOperators      Operator[]      @relation("OperatorUpdatedBy")
  createdAircraft       Aircraft[]      @relation("AircraftCreatedBy")
  updatedAircraft       Aircraft[]      @relation("AircraftUpdatedBy")
  createdTripRequests   TripRequest[]   @relation("TripRequestCreatedBy")
  updatedTripRequests   TripRequest[]   @relation("TripRequestUpdatedBy")
  assignedTripRequests  TripRequest[]   @relation("TripRequestAssignedBroker")
  createdOperatorQuotes OperatorQuote[] @relation("OperatorQuoteCreatedBy")
  updatedOperatorQuotes OperatorQuote[] @relation("OperatorQuoteUpdatedBy")
  createdQuotes         Quote[]         @relation("QuoteCreatedBy")
  updatedQuotes         Quote[]         @relation("QuoteUpdatedBy")
  assignedQuotes        Quote[]         @relation("QuoteAssignedBroker")
  createdQuoteVersions  QuoteVersion[]  @relation("QuoteVersionCreatedBy")
  createdFiles          FileObject[]    @relation("FileObjectCreatedBy")
  updatedFiles          FileObject[]    @relation("FileObjectUpdatedBy")

  /// This user's personal document folder — their 1099 and anything else the
  /// company files against them. `onDelete: Cascade` on the owning side is
  /// deliberate and harmless here: users are never deleted (suspending is the
  /// way out), so it exists only to state that a folder cannot outlive its
  /// owner.
  ownedFiles FileObject[] @relation("FileObjectOwnerUser")

  /// Who archived a record, and who brought it back. Separate from created/
  /// updated because "removed this" is the one mutation those two never
  /// capture — an archived row's `updatedBy` is whoever last edited it.
  deletedClients         Client[]        @relation("ClientDeletedBy")
  restoredClients        Client[]        @relation("ClientRestoredBy")
  deletedAirports        Airport[]       @relation("AirportDeletedBy")
  restoredAirports       Airport[]       @relation("AirportRestoredBy")
  deletedOperators       Operator[]      @relation("OperatorDeletedBy")
  restoredOperators      Operator[]      @relation("OperatorRestoredBy")
  deletedAircraft        Aircraft[]      @relation("AircraftDeletedBy")
  restoredAircraft       Aircraft[]      @relation("AircraftRestoredBy")
  deletedTripRequests    TripRequest[]   @relation("TripRequestDeletedBy")
  restoredTripRequests   TripRequest[]   @relation("TripRequestRestoredBy")
  deletedOperatorQuotes  OperatorQuote[] @relation("OperatorQuoteDeletedBy")
  restoredOperatorQuotes OperatorQuote[] @relation("OperatorQuoteRestoredBy")
  deletedQuotes          Quote[]         @relation("QuoteDeletedBy")
  restoredQuotes         Quote[]         @relation("QuoteRestoredBy")
  deletedFiles           FileObject[]    @relation("FileObjectDeletedBy")
  restoredFiles          FileObject[]    @relation("FileObjectRestoredBy")

  // ---- Audit trail (every model carries these four) ------------------------
  //
  // For a user, "created by" is who invited them: an invitation is how a staff
  // account comes into existence, so a separate invitedBy/invitedAt pair would
  // be the same two facts under a second name.
  //
  // Both are nullable and use SetNull: the seeded owner has no creator, and
  // removing whoever made a change must never destroy the record of it.
  createdAt    DateTime @default(now())
  createdById  String?  @db.Uuid
  createdBy    User?    @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]   @relation("UserCreatedBy")

  updatedAt    DateTime @updatedAt
  updatedById  String?  @db.Uuid
  updatedBy    User?    @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedUsers User[]   @relation("UserUpdatedBy")

  /// A staff account is never removed — suspending is the way out — so this
  /// model carries no archive trail, unlike every other soft-deletable model.
  ///
  /// `deletedAt` itself stays: auth refuses a stamped row a session, which
  /// makes it a database-level kill switch, and it is what keeps the handful of
  /// rows archived before the feature was withdrawn out of every list.
  deletedAt DateTime?

  @@index([role, status])
  @@index([deletedAt])
  @@map("users")
}

/// Ordered most- to least-privileged. The Roles & Permissions screen shows
/// four of these; SUPER_ADMIN is deliberately not offered in the UI — it is
/// the seeded owner account, which cannot be demoted or deleted so the system
/// can never be locked out of its own administration.
///
/// Capabilities are NOT derived from this ordering. They come from the matrix
/// in src/common/authorization/permissions.ts, which is the single source of
/// truth and mirrors the Roles & Permissions tab.
enum UserRole {
  SUPER_ADMIN
  ADMIN
  SENIOR_BROKER
  BROKER
  ASSISTANT
}

/// INVITED covers an account that exists but has never signed in — it holds no
/// usable password until the invitation is accepted. SUSPENDED is a revoked
/// account: the row and all its history stay, but it cannot authenticate.
enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

/// One row per issued refresh token, so sessions can be revoked server-side.
/// Only the hash is stored: a database leak must not yield usable sessions.
model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique

  /// Rotation lineage. On refresh the old token is revoked and points at its
  /// replacement, so reuse of a revoked token is detectable as theft.
  replacedByTokenId String?

  userAgent String?
  ipAddress String?

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
