/// Every file the desk stores: a broker's 1099, a referral programme brochure,
/// a photo of a cabin.
///
/// The bytes live in object storage (S3, or the VPS disk — see
/// `src/core/storage/`); this table is the record *about* them. Nothing else
/// in the system stores a storage key, so "which files exist, who may see
/// them, and who put them there" is answered in one place rather than by a
/// `documentKey` column growing on every model that needed an attachment.
///
/// The bytes and the row can disagree in exactly one direction, on purpose:
/// archiving a file leaves the object in storage untouched, because there is
/// no permanent delete in this system and a restore has to be able to hand
/// back the same bytes.
model FileObject {
  id String @id @default(uuid()) @db.Uuid

  /// The opaque key the storage driver wrote under. Never shown to a browser
  /// and never built from the uploaded filename — see `StorageService.buildKey`
  /// for why a caller-supplied name is a path-traversal and collision source.
  ///
  /// Unique so an upload cannot be registered twice, and so the download route
  /// can resolve a key back to its permission rules.
  storageKey String @unique

  /// Which backend held it when it was written ("s3" or "local").
  ///
  /// Recorded because the driver is an environment decision that can change
  /// under a database that does not: after a move to S3, this is what finds
  /// the rows whose bytes are still on the old disk.
  driver String @db.VarChar(16)

  /// What the uploader called it, shown in the UI and used for the download
  /// filename. Display only — it is never part of `storageKey`.
  filename String @db.VarChar(255)

  /// Sniffed from the bytes, not trusted from the upload header. A browser
  /// renders what this says, so an attacker-chosen `text/html` on a file the
  /// desk thinks is a PDF is a stored-XSS vector.
  contentType String @db.VarChar(128)

  /// Bytes. Stored so a list can show a size without touching object storage.
  size Int

  /// SHA-256 of the contents.
  ///
  /// Not deduplication — two brokers' identical 1099 templates are two files.
  /// It is here so "is this the form we actually sent him" can be answered
  /// years later, and so a silently corrupted object is detectable.
  checksum String @db.VarChar(64)

  /// What the file is for, and — through `FILE_CATEGORY_RULES` in the service
  /// — who may read and write it. A tax form and a marketing brochure are both
  /// PDFs in the same bucket; this column is the entire difference between
  /// them, which is why it is required and has no catch-all value.
  category FileCategory

  /// A human label ("2025 Form 1099-NEC") and free notes. Both optional: the
  /// filename is usually enough, and a forced label produces "document1".
  label String? @db.VarChar(200)
  notes String?

  /// Who the file belongs to. At most one is set; a `RESOURCE` has none,
  /// because company-wide material belongs to the company.
  ///
  /// Real foreign keys rather than one polymorphic `ownerType`/`ownerId` pair:
  /// a polymorphic link cannot be checked by the database, so a deleted owner
  /// leaves a row pointing at nothing and no constraint says so. The cost is a
  /// column per owner kind, added when that owner actually exists — see
  /// AGENTS.md on not building for modules that do not.
  ownerUserId String? @db.Uuid
  ownerUser   User?   @relation("FileObjectOwnerUser", fields: [ownerUserId], references: [id], onDelete: Cascade)

  aircraftId String?   @db.Uuid
  aircraft   Aircraft? @relation("FileObjectAircraft", fields: [aircraftId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  createdBy   User?    @relation("FileObjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
  updatedBy   User?    @relation("FileObjectUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  deletedAt   DateTime?
  deletedById String?   @db.Uuid
  deletedBy   User?     @relation("FileObjectDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  restoredAt   DateTime?
  restoredById String?   @db.Uuid
  restoredBy   User?     @relation("FileObjectRestoredBy", fields: [restoredById], references: [id], onDelete: SetNull)

  /// The two lists the UI actually asks for: "this broker's folder" and
  /// "photos of this tail", both filtered to live rows and newest first.
  @@index([category, deletedAt, createdAt])
  @@index([ownerUserId, deletedAt])
  @@index([aircraftId, deletedAt])
  @@map("file_objects")
}

/// What a file is for. Each value maps to a read rule and a write rule in
/// `files.access.ts`, so adding one here without deciding those two will not
/// compile — which is the point. A category with no rule is a file nobody has
/// decided who may open.
///
/// There is deliberately no `OTHER`: a catch-all is a category whose access
/// rule cannot be stated, and the first file dropped into it would be the one
/// nobody meant to share.
enum FileCategory {
  /// A document in one user's personal folder — a 1099, a signed contractor
  /// agreement. The most sensitive thing this table holds: readable by its
  /// owner and by an administrator, and by nobody else, including other
  /// brokers of the same rank.
  USER_DOCUMENT

  /// Company-wide material published by Tribeca: the brochure, the aircraft
  /// category guide, referral programme terms. Readable by everyone signed in,
  /// writable by an administrator.
  RESOURCE

  /// A photograph of an aircraft, for quotes and itineraries. Follows the
  /// fleet's own permission, so whoever may edit a tail may add pictures of it.
  AIRCRAFT_PHOTO
}
