/// Clients and travel agents share one table: they carry the same trip,
/// quote and payment relationships and differ only by `type` plus which
/// fields are populated. Splitting them would duplicate every relation.
model Client {
  id   String     @id @default(uuid()) @db.Uuid
  type ClientType @default(DIRECT)

  /// Where the relationship stands, which is a different axis from where the
  /// deal stands. A VIP can be mid-pipeline and a booked client can go
  /// dormant, so this never replaces `leadStage` — the table's one Status
  /// column renders from both.
  ///
  /// Defaults to LEAD: a row someone just typed in is a prospect until they
  /// book something.
  status ClientStatus @default(LEAD)

  /// Populated for travel agents and corporate accounts.
  companyName String?
  firstName   String
  lastName    String
  email       String?
  phone       String?

  /// Date only — drives VIP birthday reminders on the daily brief.
  birthday DateTime? @db.Date

  /// A real relation, not the ICAO string it used to be. Airports did not
  /// exist when this model was first written; they do now, and the project
  /// rule is that a module connects to what it references rather than storing
  /// its name. SetNull because archiving an airport must not delete clients.
  homeAirportId String?  @db.Uuid
  homeAirport   Airport? @relation("ClientHomeAirport", fields: [homeAirportId], references: [id], onDelete: SetNull)

  leadSource LeadSource @default(DIRECT)
  leadStage  LeadStage  @default(NEW)

  /// Currently responsible broker; brokers only see rows where this is them.
  assignedBrokerId String? @db.Uuid
  assignedBroker   User?   @relation("ClientAssignedBroker", fields: [assignedBrokerId], references: [id], onDelete: SetNull)

  /// Who first brought the relationship in. Drives commission attribution and
  /// survives reassignment of `assignedBrokerId`.
  originatingBrokerId String? @db.Uuid
  originatingBroker   User?   @relation("ClientOriginatingBroker", fields: [originatingBrokerId], references: [id], onDelete: SetNull)

  /// Travel preferences (pets, catering, FBO, no red-eye, baggage, ...).
  /// Held as JSON because the scope lists these as an open, still-growing set;
  /// any preference that gains business rules graduates to a real column.
  preferences Json @default("{}")

  /// The next scheduled contact. Drives the "Follow-ups Due" tile, the
  /// Due Today / Overdue / Upcoming filter and the follow-up dialog.
  /// When the Tasks module lands it should read these rather than replace
  /// them — a follow-up is a property of the relationship, not a side table.
  nextFollowUpAt DateTime?
  followUpNote   String?

  notes  String?
  labels String[] @default([])

  // ---- Audit trail (every model carries these four) ------------------------
  // Distinct from assignedBroker/originatingBroker, which are business
  // relationships: an admin can create a client assigned to someone else, and
  // reassigning it later must not rewrite who first entered the record.
  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  createdBy   User?    @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
  updatedBy   User?    @relation("ClientUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  /// ---- Archive trail ------------------------------------------------------
  /// Soft delete is the only delete: nothing in this system is destroyed, so
  /// these three answer "who archived this, and did anyone bring it back".
  ///
  /// `restoredAt` survives a later archive on purpose — the columns hold the
  /// most recent event of each kind, and the full back-and-forth lives in the
  /// audit log rather than in a widening set of columns.
  deletedAt   DateTime?
  deletedById String?   @db.Uuid
  deletedBy   User?     @relation("ClientDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  restoredAt   DateTime?
  restoredById String?   @db.Uuid
  restoredBy   User?     @relation("ClientRestoredBy", fields: [restoredById], references: [id], onDelete: SetNull)

  @@index([assignedBrokerId, deletedAt])
  @@index([type, leadStage])
  @@index([status, deletedAt])
  @@index([nextFollowUpAt])
  @@index([email])
  @@index([lastName, firstName])
  @@map("clients")
}

/// Set by a person, unlike `leadStage`, which moves as the deal moves.
enum ClientStatus {
  LEAD
  ACTIVE
  VIP
  INACTIVE
}

enum ClientType {
  DIRECT
  TRAVEL_AGENT
}

enum LeadSource {
  DIRECT
  TRAVEL_AGENT
  FACEBOOK_GROUP_1
  FACEBOOK_GROUP_2
  REFERRAL
  WEBSITE
  OTHER
}

enum LeadStage {
  NEW
  CONTACTED
  QUOTED
  NEGOTIATING
  BOOKED
  LOST
}
