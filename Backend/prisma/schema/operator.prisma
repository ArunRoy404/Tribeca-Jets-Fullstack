/// Charter operators — the companies that actually fly the aircraft.
///
/// Master data shared across the desk: sourcing requests, quotes, trips and
/// operator payments all point here. Their fleet lives in the Aircraft module,
/// which references this table rather than the other way round.
model Operator {
  id     String         @id @default(uuid()) @db.Uuid
  name   String
  status OperatorStatus @default(ACTIVE)

  /// Free text ("Cleveland, OH") rather than an Airport relation: an
  /// operator's home base is a city in the UI, and several list a city with no
  /// single airport. If trips ever need to route from it, it becomes a real
  /// foreign key then.
  homeBase String?
  website  String?

  /// The company's switchboard, distinct from the named contact below — the
  /// dispatch line stays valid when the account manager changes.
  generalEmail String?
  generalPhone String?

  /// The named account manager and their direct line.
  primaryContact String?
  contactEmail   String?
  contactPhone   String?

  /// Fleet summary ("Global 7500", "Challenger 350") and the routes they serve
  /// ("KTEB ↔ KMIA"), both shown as chips on the operator card.
  ///
  /// `aircraftTypes` is now a second record of what `fleet` below already
  /// knows. It is kept because an operator can be catalogued before a single
  /// tail of theirs is, and the sourcing note "they fly Globals" is useful
  /// before any airframe exists to prove it. Where the two disagree, `fleet`
  /// is the fact and this is the claim.
  aircraftTypes String[] @default([])
  serviceRoutes String[] @default([])

  /// The airframes they operate. SetNull on the other side, so archiving an
  /// operator never removes an aircraft — it only unassigns it.
  fleet Aircraft[] @relation("AircraftOperator")

  /// Out of 5, one decimal, as the operator card renders it (4.8).
  reliabilityRating Float?
  /// A certification, not a number: "ARG/US Platinum", "Wyvern Wingman",
  /// "IS-BAO Stage 3". Free text because the issuing bodies and their tiers
  /// change independently of this product.
  safetyRating      String?
  /// Typical quote turnaround, as the desk describes it ("< 15 min").
  responseSpeed     String?

  cancellationPolicy String?
  /// "Net 30", "Due upon receipt".
  paymentTerms       String?
  /// What the desk needs to remember when sourcing from them.
  sourcingNotes      String?

  // ---- Audit trail (every model carries these four) ------------------------
  /// Every quote this operator has given us. The scorecard in scope §6.7 —
  /// response speed, win rate, how often they came in over budget — is
  /// counted from here.
  operatorQuotes OperatorQuote[] @relation("OperatorQuoteOperator")

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  createdBy   User?    @relation("OperatorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
  updatedBy   User?    @relation("OperatorUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  /// ---- Archive trail ------------------------------------------------------
  /// Soft delete is the only delete: nothing in this system is destroyed, so
  /// these three answer "who archived this, and did anyone bring it back".
  ///
  /// `restoredAt` survives a later archive on purpose — the columns hold the
  /// most recent event of each kind, and the full back-and-forth lives in the
  /// audit log rather than in a widening set of columns.
  deletedAt   DateTime?
  deletedById String?   @db.Uuid
  deletedBy   User?     @relation("OperatorDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  restoredAt   DateTime?
  restoredById String?   @db.Uuid
  restoredBy   User?     @relation("OperatorRestoredBy", fields: [restoredById], references: [id], onDelete: SetNull)

  @@index([status, deletedAt])
  @@index([name])
  @@map("operators")
}

enum OperatorStatus {
  ACTIVE
  PREFERRED
  INACTIVE
}
