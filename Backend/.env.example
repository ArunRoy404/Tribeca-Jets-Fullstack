# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=api
WEB_APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# ---- Data ------------------------------------------------------------------
DATABASE_URL="postgresql://tribeca:tribeca_dev_password@localhost:5432/tribeca_jets?schema=public"
REDIS_URL="redis://localhost:6380"

# ---- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-me-with-at-least-32-characters-of-entropy"
JWT_REFRESH_SECRET="replace-me-with-a-different-32-plus-character-secret"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Empty in development. In production: .tribecajetscommandcenter.com
COOKIE_DOMAIN=
COOKIE_SECURE=false
CORS_ORIGINS=

# ---- Storage ---------------------------------------------------------------
# auto = use S3 when credentials below are complete, else local disk.
STORAGE_DRIVER=auto
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ---- AI --------------------------------------------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
