# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=api
WEB_APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# ---- Data ------------------------------------------------------------------
DATABASE_URL="postgresql://tribeca:tribeca_dev_password@localhost:5432/tribeca_jets?schema=public"
REDIS_URL="redis://localhost:6380"

# ---- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-me-with-at-least-32-characters-of-entropy"
JWT_REFRESH_SECRET="replace-me-with-a-different-32-plus-character-secret"
JWT_ACCESS_TTL=10m
# A session untouched for this long has to sign in again (client request #4).
AUTH_IDLE_TIMEOUT_MINUTES=10
JWT_REFRESH_TTL=7d
# Used when the user ticks "Remember me"
JWT_REFRESH_TTL_REMEMBERED=30d

# ---- One-time codes (2FA + password reset) ---------------------------------
TWO_FACTOR_CODE_TTL_MINUTES=10
PASSWORD_RESET_CODE_TTL_MINUTES=15
PASSWORD_RESET_WINDOW_MINUTES=15
VERIFICATION_MAX_ATTEMPTS=5

# Empty, in production too: one domain serves the web app and the API.
COOKIE_DOMAIN=
COOKIE_SECURE=false
CORS_ORIGINS=

# ---- Storage ---------------------------------------------------------------
# auto = use S3 when S3_BUCKET + both keys are set, else local disk.
# s3   = always S3; a missing key is a boot error (use this on any host whose
#        disk is wiped — Render — so a typo cannot silently fall back to it).
# local = files under STORAGE_LOCAL_PATH (a persistent disk: your machine, a VPS).
STORAGE_DRIVER=auto
STORAGE_LOCAL_PATH=./storage

# Any S3-compatible bucket. The dev deployment uses Backblaze B2 (free, no card):
#   S3_ENDPOINT=https://s3.<region>.backblazeb2.com   (the bucket card's Endpoint)
#   S3_REGION=<region>                                (e.g. us-west-004)
#   S3_BUCKET=<bucket name>
#   S3_ACCESS_KEY_ID=<application key's keyID>
#   S3_SECRET_ACCESS_KEY=<applicationKey>
# Real AWS S3: leave S3_ENDPOINT empty and set S3_REGION (e.g. ap-southeast-1).
# Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto.
# The bucket stays private: the API streams every file itself.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Unused unless the bucket sits behind a public CDN. Leave empty.
S3_PUBLIC_URL=
# Newer AWS SDKs add checksum headers to every upload, which some S3-compatible
# stores reject. WHEN_REQUIRED sends them only where an operation needs one.
# Read by the AWS SDK itself, not by the app's config.
AWS_REQUEST_CHECKSUM_CALCULATION=WHEN_REQUIRED
AWS_RESPONSE_CHECKSUM_VALIDATION=WHEN_REQUIRED

# ---- Mail ------------------------------------------------------------------
# auto = use SMTP when credentials below are complete, else print to the log
# (development only — production refuses to start without SMTP).
MAIL_DRIVER=auto
MAIL_FROM="Tribeca Jets <no-reply@tribecajets.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---- AI --------------------------------------------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Rate limiting ----------------------------------------------------------
# Multiplies every per-route @RateLimit allowance. Must be 1 in production —
# the app refuses to boot otherwise.
#
# Raise it locally (20 is plenty) to run the Postman collection end to end:
# that pass signs in eight times against a login limit of five per fifteen
# minutes, so it cannot otherwise complete. Relax this rather than the limits
# themselves, which are tuned for real users.
RATE_LIMIT_MULTIPLIER=1
# Set false only to debug locally. Refused in production.
RATE_LIMIT_ENABLED=true
