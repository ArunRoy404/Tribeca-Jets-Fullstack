# ---- API ---------------------------------------------------------------------
# Where the Next server forwards /api/* to. SERVER-ONLY (no NEXT_PUBLIC_ prefix):
# the browser never needs to know where the API actually lives.
API_PROXY_TARGET=http://localhost:4000

# What the browser calls. Relative by default, so requests hit the Next server
# and are proxied on — keeping session cookies first-party (no CORS, no
# SameSite negotiation, not blocked as third-party cookies).
#
# Set an absolute URL (https://api.tribecajetscommandcenter.com/api) only to
# bypass the proxy; the API's CORS allowlist must then include the web origin.
NEXT_PUBLIC_API_URL=/api

# ---- React Query -----------------------------------------------------------
# All values in milliseconds unless noted.

# How long fetched data stays fresh before a refetch is allowed.
NEXT_PUBLIC_QUERY_STALE_TIME=60000
# How long unused data stays cached before garbage collection.
NEXT_PUBLIC_QUERY_GC_TIME=300000

# Retry attempts after the first failure. 4xx responses are never retried —
# the server already answered definitively.
NEXT_PUBLIC_QUERY_RETRY_COUNT=2
# Base backoff; doubles per attempt, capped by RETRY_DELAY_MAX.
NEXT_PUBLIC_QUERY_RETRY_DELAY=1000
NEXT_PUBLIC_QUERY_RETRY_DELAY_MAX=30000

# Refetch triggers (true/false).
NEXT_PUBLIC_QUERY_REFETCH_ON_WINDOW_FOCUS=false
NEXT_PUBLIC_QUERY_REFETCH_ON_MOUNT=true
NEXT_PUBLIC_QUERY_REFETCH_ON_RECONNECT=true

# Background polling for ordinary queries. 0 disables it.
NEXT_PUBLIC_QUERY_REFETCH_INTERVAL=0

# Preset overrides.
# `session`  — how long GET /auth/me stays fresh.
NEXT_PUBLIC_AUTH_STALE_TIME=300000
# `static`   — reference data: airports, aircraft types, roles.
NEXT_PUBLIC_QUERY_STATIC_STALE_TIME=3600000
# `live`     — dashboards and trackers. 0 disables polling.
NEXT_PUBLIC_QUERY_LIVE_INTERVAL=30000

# Mutations are not safe to replay blindly, so this defaults to 0.
NEXT_PUBLIC_MUTATION_RETRY_COUNT=0
