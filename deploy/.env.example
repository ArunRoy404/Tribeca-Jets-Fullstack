# Production settings for deploy/docker-compose.yml.
# Copy to deploy/.env on the VPS and fill in. Never commit the copy.
#
# NODE_ENV, DATABASE_URL, REDIS_URL, cookies, the storage and mail drivers and
# the rate limits are fixed in docker-compose.yml, not here.

# ---- Site ------------------------------------------------------------------
DOMAIN=tribecajetscommandcenter.com
# Let's Encrypt expiry notices go here.
ACME_EMAIL=

# ---- Database --------------------------------------------------------------
# Generate with: openssl rand -hex 24
# Hex on purpose — it is pasted into a connection URL, where / @ : would break it.
POSTGRES_PASSWORD=
BACKUP_KEEP_DAYS=14

# ---- Auth ------------------------------------------------------------------
# Two different values, each from: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=10m
AUTH_IDLE_TIMEOUT_MINUTES=10
JWT_REFRESH_TTL=7d
JWT_REFRESH_TTL_REMEMBERED=30d

# ---- Uploads: Cloudflare R2 ------------------------------------------------
# R2 → the bucket → Settings: the S3 API endpoint, without the bucket name.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
# R2 → Manage API tokens → Create: Object Read & Write, this bucket only.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Mail (required: the API refuses to start without it) ------------------
# Google Workspace: smtp.gmail.com, 587, the full Workspace address, and an
# app password for that account (needs 2-Step Verification on it).
# Brevo: smtp-relay.brevo.com, 587, the SMTP login and key from its dashboard.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Gmail rewrites the sender to SMTP_USER unless it is that address or an alias
# of it; Brevo needs the sending domain verified.
MAIL_FROM="Tribeca Jets <no-reply@tribecajetscommandcenter.com>"

# ---- AI (optional) ---------------------------------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
